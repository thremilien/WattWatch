# --- Auth (required) ---------------------------------------------------------
# The single admin account. The password is bcrypt-hashed into the database on
# first startup; changing ADMIN_PASSWORD later updates the stored hash on boot.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If left unset, a random secret is generated at startup and all sessions are
# invalidated on every restart.
SECRET_KEY=

# --- Device ------------------------------------------------------------------
# IP address of the Kasa HS110 on your local network.
KASA_HOST=192.168.10.8

# --- Optional tuning ---------------------------------------------------------
# How often the backend polls the plug for live readings (seconds).
# POLL_INTERVAL_SECONDS=5
# How often a polled reading is persisted to SQLite for long-term history (seconds).
# HISTORY_INTERVAL_SECONDS=60
# How long to keep persisted readings (days). 0 disables pruning.
# HISTORY_RETENTION_DAYS=90
# Path to the SQLite database file.
# DATABASE_PATH=/data/wattwatch.db
# Set to 1 only when serving over plain HTTP; disables the Secure cookie flag.
# INSECURE_COOKIES=0
